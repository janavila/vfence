[Unit]
Description=Servidor local VFence
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/vfence
EnvironmentFile=-/home/pi/vfence/.env
ExecStart=/home/pi/vfence/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
