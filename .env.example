VFENCE_HOST=0.0.0.0
VFENCE_PORT=8000
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
DATABASE_URL=sqlite:///./vfence.db
VFENCE_MOCK_SERIAL=false
SERIAL_RECONNECT_SECONDS=3
COLLAR_OFFLINE_SECONDS=30
MAX_LINE_LENGTH=512
MOCK_INTERVAL_SECONDS=3

# Sincronização com o servidor Central. Permanece desligada por padrão.
CENTRAL_SYNC_ENABLED=false
CENTRAL_BASE_URL=http://127.0.0.1:8001
BASE_ID=BASE01
BASE_TOKEN=troque-este-token
CENTRAL_TIMEOUT_SECONDS=10
CENTRAL_SYNC_INTERVAL_SECONDS=5
CENTRAL_RETRY_SECONDS=5
CENTRAL_BATCH_SIZE=100
COLLAR_IDS=COL01,COL02
COLLAR_TELEMETRY_SECONDS=10
COLLAR_GPS_TIMEOUT_SECONDS=60
COLLAR_LOW_BATTERY_PCT=20
COLLAR_CRITICAL_BATTERY_PCT=5
