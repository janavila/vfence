# Modelo de configuração do Central (VFence Web).
#
# Copie para .env e ajuste. O .env NUNCA vai para o Git.
#   cp .env.example .env
#
# Os nomes das variáveis são os da seção 14 da especificação, copiados
# sem alteração: este arquivo é lido também pelo responsável pela Base e
# pelo contrato da fase F7, então ele não pode divergir do documento.

# ----- Servidor -----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data

# ----- Base de desenvolvimento (cadastrada na inicialização) -----
# BASE_TOKEN é o segredo que a Base envia em "Authorization: Bearer ...".
# O Central guarda apenas o hash dele no banco; troque antes de usar na bancada.
BASE_ID=BASE01
BASE_TOKEN=troque-este-token
BASE_LAT=-31.306200
BASE_LON=-54.063950
BASE_OFFLINE_APOS_S=30
COLARES_CONHECIDOS=COL01,COL02

# ----- Regras da cerca -----
# Margens padrão sugeridas no editor (DEC-10, provisórias).
MARGEM_ATENCAO_PADRAO_M=5.0
MARGEM_CRITICA_PADRAO_M=2.0
# Raio máximo aceito entre um ponto da cerca e a Base (VAL-03).
BASE_RAIO_MAX_KM=5
# Alcance de rádio medido no ensaio da IP1 (VAL-10, só aviso).
LORA_ALCANCE_M=200
# Erro horizontal esperado do GNSS e folga recomendada (VAL-07 e VAL-12).
GNSS_ERRO_ESPERADO_M=3.0
GNSS_FATOR_SEGURANCA=1.5

# ----- Login do produtor -----
# AUTH_ENABLED=false libera o sistema sem login. NÃO é da especificação:
# foi acrescentado para a bancada e as demonstrações, onde pedir senha a
# cada teste atrapalha. Em uso real deixe true.
AUTH_ENABLED=true
ADMIN_USER=produtor
ADMIN_PASSWORD=troque-esta-senha
# Chave que assina o cookie de sessão. Trocar aqui desconecta todo mundo.
# Gere uma: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=troque-esta-chave
